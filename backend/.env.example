# Mẫu cấu hình máy chủ (Bảng G.2 của báo cáo). Sao chép thành tệp .env rồi điền giá trị.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce
# Bắt buộc: chuỗi bí mật bất kỳ để ký mã thông báo đăng nhập
JWT_SECRET=
# Không bắt buộc: thiếu khóa thì Tiger AI hiển thị thông báo bảo trì
GEMINI_API_KEY=
PORT=5000
