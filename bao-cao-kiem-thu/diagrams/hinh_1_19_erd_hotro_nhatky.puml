@startuml
' Hinh 1.19 - So do ERD phan he Ho tro khach hang va Nhat ky he thong
!theme plain
skinparam dpi 200
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam shadowing false
hide circle

entity "users" as users {
  * id : INT <<PK>>
  --
  name : VARCHAR(100)
  email : VARCHAR(100)
  # role_id : INT <<FK>>
  status : VARCHAR(20)
}

entity "products" as products {
  * id : INT <<PK>>
  --
  name : VARCHAR(255)
  stock : INT
}

entity "threads" as threads {
  * id : INT <<PK>>
  --
  # user_id : INT <<FK>>
  status : VARCHAR(30)
  is_ai_muted : TINYINT
}

entity "chat_messages" as cmsg {
  * id : INT <<PK>>
  --
  # thread_id : INT <<FK>>
  sender_role : VARCHAR(20)
  sender_id : INT
  receiver_id : INT
  message : TEXT
  # order_id : INT <<FK>>
  type : VARCHAR(20)
  created_at : TIMESTAMP
}

entity "ai_chat_sessions" as aisess {
  * id : INT <<PK>>
  --
  # user_id : INT <<FK>> <<UNIQUE>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "ai_chat_messages" as aimsg {
  * id : INT <<PK>>
  --
  # session_id : INT <<FK>>
  role : ENUM('USER','AI')
  message : TEXT
  voucher : VARCHAR(50)
  metadata : JSON
  created_at : TIMESTAMP
}

entity "notifications" as notis {
  * id : INT <<PK>>
  --
  # user_id : INT <<FK>>
  title : VARCHAR(255)
  message : TEXT
  type : VARCHAR(50)
  is_read : TINYINT
  created_at : TIMESTAMP
}

entity "user_activity_logs" as alogs {
  * id : INT <<PK>>
  --
  # user_id : INT <<FK>>
  action : VARCHAR(255)
  target_id : INT
  created_at : TIMESTAMP
}

entity "inventory_logs" as ilogs {
  * id : INT <<PK>>
  --
  # product_id : INT <<FK>>
  # manager_id : INT <<FK>>
  quantity_added : INT
  old_stock : INT
  new_stock : INT
  note : VARCHAR(255)
  created_at : TIMESTAMP
}

threads -[hidden]down- notis
aisess  -[hidden]down- alogs
cmsg    -[hidden]down- ilogs

users ||--o| threads : "1 - 0..1"
users ||--o| aisess  : "1 - 0..1"
users ||--o{ notis   : "1 - N"
users ||--o{ alogs   : "1 - N"
users ||--o{ ilogs   : "1 - N"
threads ||--o{ cmsg  : "1 - N"
aisess  ||--o{ aimsg : "1 - N"
products ||--o{ ilogs : "1 - N"

@enduml
